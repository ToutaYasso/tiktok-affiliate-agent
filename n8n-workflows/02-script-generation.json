                      "typeVersion":  2,
                      "position":  [
                                       1500,
                                       400
                                   ],
                      "parameters":  {
                                         "jsCode":  "return $input.all().map((item, i) =\u003e {\n  const dbRow = item.json; // {id:31, product_id:52, script:\"...\", status:...}\n  const parsed = ($(\u0027Parse Script\u0027).all()[i] || {}).json || {};\n  return {\n    json: {\n      video_id:      dbRow.id,\n      product_id:    dbRow.product_id,\n      product_title: parsed.product_title || \u0027\u0027,\n      script_hook:   parsed.script_hook   || \u0027\u0027,\n      full_script:   parsed.full_script   || dbRow.script || \u0027{}\u0027,\n      hashtags:      parsed.hashtags      || \u0027\u0027\n    }\n  };\n});"
