                  {
                      "id":  "wf02-build-prompt",
                      "name":  "Build Gemini Prompt",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       620,
                                       400
                                   ],
                      "parameters":  {
                                         "jsCode":  "return $input.all().map(item =\u003e {\n  const p = item.json;\n  const prompt = `Tu es expert TikTok affiliate. Cr�e un script de 25s pour ce produit.\nTitre: ${p.title}\nPrix: ${p.price}?\nCat�gorie: ${p.category}\nPourquoi viral: ${p.why_viral}\nHook sugg�r�: ${p.hook}\n\nRetourne UNIQUEMENT ce JSON valide:\n{\"script\": {\"title\": \"...\", \"hook\": \"...0-3s\", \"scene1\": \"...3-10s\", \"scene2\": \"...10-18s\", \"scene3\": \"...18-23s\", \"cta\": \"...23-25s\", \"hashtags\": [\"#tiktok\",\"#affiliate\",\"#viral\",\"#deal\",\"#pourtoi\"], \"duration_seconds\": 25}}`;\n\n  return {\n    json: {\n      ...p,\n      geminiBody: JSON.stringify({\n        contents: [{ parts: [{ text: prompt }] }],\n        generationConfig: { temperature: 0.7, maxOutputTokens: 600 }\n      })\n    }\n  };\n});"
                                     }
                  },
                  {
                      "id":  "wf02-gemini",
                      "name":  "Gemini Script Generator",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       840,
                                       400
                                   ],
                      "retryOnFail":  true,
                      "maxTries":  3,
                      "waitBetweenTries":  5000,
                      "parameters":  {
                                         "method":  "POST",
                                         "url":  "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent",
                                         "authentication":  "none",
                                         "sendQuery":  true,
                                         "specifyQuery":  "keypair",
                                         "queryParameters":  {
                                                                 "parameters":  [
                                                                                    {
                                                                                        "name":  "key",
                                                                                        "value":  "={{ $env.GEMINI_API_KEY }}"
                                                                                    }
                                                                                ]
                                                             },
                                         "sendBody":  true,
                                         "contentType":  "raw",
                                         "rawContentType":  "application/json",
                                         "body":  "={{ $json.geminiBody }}"
                                     }
                  },
                  {
                      "id":  "wf02-parse",
                      "name":  "Parse Script",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       1060,
                                       400
                                   ],
                      "parameters":  {
                                         "jsCode":  "return $input.all().map((item, index) =\u003e {\n  const geminiResponse = item.json;\n  const triggerItems = $(\u0027Trigger from WF01\u0027).all();\n  const productData = (triggerItems[index] || triggerItems[0]).json;\n\n  let script = {};\n  try {\n    const text = geminiResponse.candidates[0].content.parts[0].text;\n    const jsonMatch = text.match(/\\{[\\s\\S]*\\}/);\n    if (jsonMatch) {\n      const parsed = JSON.parse(jsonMatch[0]);\n      script = parsed.script || {};\n    }\n  } catch(e) {\n    console.log(\u0027Script parse error:\u0027, e.message);\n    script = { title: \u0027D�couvrez \u0027 + (productData.title || \u0027ce produit\u0027), hook: \u0027...\u0027, scene1: \u0027...\u0027, scene2: \u0027...\u0027, scene3: \u0027...\u0027, cta: \u0027...\u0027 };\n  }\n\n  return {\n    json: {\n      product_id: productData.id || null,\n      product_title: productData.title,\n      platform: productData.platform,\n      script_title: script.title,\n      script_hook: script.hook,\n      script_scene1: script.scene1,\n      script_scene2: script.scene2,\n      script_scene3: script.scene3,\n      script_cta: script.cta,\n      hashtags: (script.hashtags || []).join(\u0027 \u0027),\n      duration_seconds: script.duration_seconds || 25,\n      full_script: JSON.stringify(script),\n      generated_at: new Date().toISOString()\n    }\n  };\n});"
                                     }
                  },
